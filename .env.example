# Copy to .env and fill in your Google OAuth credentials.
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where the browser reaches the app. The OAuth redirect URI is
# `${APP_BASE_URL}/api/auth/callback/google` and must be registered on the
# OAuth client's "Authorized redirect URIs".
APP_BASE_URL=http://localhost:3001

# Port the auth server listens on (proxied under /api by Vite in dev).
PORT=8787
